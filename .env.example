# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
# Optional: Guild ID for fast development command deployment
DISCORD_GUILD_ID=

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/ktkt_discord_bot

# Environment & Logging
NODE_ENV=development
LOG_LEVEL=info

# Bot Settings
DEFAULT_LANGUAGE=en
OWNER_IDS=123456789012345678,234567890123456789
ENABLE_EVAL=false
