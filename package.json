{
  "name": "ktkt-discord-bot",
  "version": "1.0.0",
  "description": "Production-grade Discord bot using discord.js v14 and Components V2",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "deploy-commands": "node scripts/deploy-commands.js",
    "deploy-commands:guild": "node scripts/deploy-commands.js --guild",
    "lint": "eslint src/ scripts/ test/",
    "lint:fix": "eslint src/ scripts/ test/ --fix",
    "format": "prettier --write \"src/**/*.{js,json}\" \"scripts/**/*.js\" \"test/**/*.js\"",
    "test": "vitest run"
  },
  "keywords": [
    "discord",
    "discord.js",
    "components-v2",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^16.4.7",
    "mongoose": "^8.12.0",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "eslint": "^9.21.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.2",
    "vitest": "^3.0.7"
  }
}
